{
  "name": "codedoodl.es",
  "description": "Creative code sketches",
  "version": "0.0.1",
  "homepage": "https://github.com/fluuuid/codedoodl.es",
  "author": {
    "name": "Neil Carpenter <neil@fluuu.id> (http://fluuu.id/)"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/fluuuid/codedoodl.es.git"
  },
  "bugs": {
    "url": "https://github.com/fluuuid/codedoodl.es/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "start": "node dist/app/start.cjs",
    "build": "gulp build",
    "watch": "gulp watch",
    "dev": "gulp dev",
    "doodle:create": "node utils/createDoodle.js",
    "doodle:preview": "node utils/previewPR.js",
    "test:build": "node build/check.mjs",
    "test:server": "node --test tests/server/*.test.cjs",
    "test": "bash tests/run.sh",
    "test:update-snapshots": "bash tests/run.sh --update-snapshots",
    "test:tools": "node --test tests/tools/*.test.cjs",
    "audit:dependencies": "node scripts/audit.mjs"
  },
  "folders": {
    "dest": "app/public",
    "src": "project",
    "vendor": "project/vendor",
    "html": "app/site"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cors": "2.8.6",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "hashids": "2.3.0",
    "underscore": "1.13.8",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "backbone": "1.6.1",
    "browser-sync": "3.0.4",
    "browserify": "17.0.1",
    "coffeeify": "3.0.1",
    "coffeescript": "2.7.0",
    "ent": "2.2.2",
    "figlet": "1.11.4",
    "gsap": "3.15.0",
    "gulp": "5.0.1",
    "jquery": "4.0.0",
    "postcss": "8.5.28",
    "sass": "1.105.0",
    "slug": "12.0.1",
    "terser": "5.51.2"
  },
  "vendor": {
    "features": "project/browser/features.js",
    "jquery": "node_modules/jquery/dist/jquery.js",
    "underscore": "node_modules/underscore/underscore-umd.js",
    "backbone": "node_modules/backbone/backbone.js",
    "backbone-deep-model": "project/vendor/backbone-deep-model.js",
    "gsap": "node_modules/gsap/dist/gsap.js",
    "animation-defaults": "project/browser/animation-defaults.js"
  },
  "packageManager": "npm@11.19.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ]
}
