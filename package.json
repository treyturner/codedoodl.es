{
  "name": "codedoodl.es",
  "description": "Creative code sketches",
  "version": "0.0.1",
  "homepage": "https://github.com/fluuuid/codedoodl.es",
  "author": {
    "name": "Neil Carpenter <neil@fluuu.id> (http://fluuu.id/)"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/fluuuid/codedoodl.es.git"
  },
  "bugs": {
    "url": "https://github.com/fluuuid/codedoodl.es/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "start": "cd app && node start.cjs",
    "build": "gulp build",
    "watch": "gulp watch",
    "dev": "gulp dev",
    "doodle:create": "node utils/createDoodle.js",
    "doodle:preview": "node utils/previewPR.js",
    "test:build": "node build/check.mjs",
    "test": "bash tests/run.sh",
    "test:update-snapshots": "bash tests/run.sh --update-snapshots"
  },
  "folders": {
    "dest": "app/public",
    "src": "project",
    "vendor": "project/vendor",
    "html": "app/site"
  },
  "dependencies": {
    "body-parser": "1.2.2",
    "coffeescript": "1.12.7",
    "colors": "1.3.3",
    "compression": "1.7.4",
    "cookie-parser": "1.0.1",
    "cors": "2.8.5",
    "ejs": "2.5.5",
    "express": "4.22.3",
    "express-session": "1.1.0",
    "hashids": "1.2.2",
    "request": "2.88.0",
    "underscore": "1.7.0",
    "winston": "0.7.3"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "browser-sync": "3.0.4",
    "browserify": "17.0.1",
    "coffeeify": "3.0.1",
    "ent": "2.2.2",
    "figlet": "1.11.4",
    "gulp": "5.0.1",
    "mkdirp": "0.5.1",
    "postcss": "8.5.28",
    "sass": "1.105.0",
    "slug": "12.0.1",
    "terser": "5.51.2",
    "valid-url": "1.0.9"
  },
  "vendor": {
    "modernizr": "modernizr-dev.js",
    "jquery": "jquery-2.1.0.js",
    "underscore": "underscore.js",
    "backbone": "backbone.js",
    "backbone-deep-model": "backbone-deep-model.js",
    "plugins": "plugins.js",
    "tweenlite": "TweenLite.js",
    "css-plugin": "CSSPlugin.js",
    "easepack": "EasePack.js",
    "script": "script.js",
    "iscroll": "iscroll-probe.js"
  },
  "packageManager": "npm@11.19.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ]
}
